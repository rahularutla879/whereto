# Optional server-only override. The default works without creating .env.local.
BACKEND_URL=http://127.0.0.1:8000

# Local AI interpretation used by Plan my outing.
# Export these in the backend Terminal; Python does not auto-load .env.local.
AI_PROVIDER=ollama
AI_MODEL=qwen3:4b
AI_BASE_URL=http://127.0.0.1:11434
AI_TIMEOUT_SECONDS=60

# Backend-only; default mock. Export in the backend Terminal if needed.
# No Google credentials are needed for mock mode. See README for deliberate local real mode.
VENUE_DATA_MODE=mock

# Do not enable these in deployed/production environments. Defaults remain off.
WHERETO_REAL_DEV=0
WHERETO_CONTACT_DETAILS_DEV=0
WHERETO_ENV=development
