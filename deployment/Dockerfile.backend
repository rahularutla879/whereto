ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
FROM ${PYTHON_IMAGE} AS build
ENV PIP_CONFIG_FILE=/dev/null PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /source
COPY deployment/requirements-linux-amd64.lock ./requirements.lock
RUN python -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir --index-url https://pypi.org/simple --require-hashes --only-binary=:all: -r requirements.lock && /opt/venv/bin/pip check
COPY backend ./backend
COPY data/mock-venues.json ./data/mock-venues.json
COPY deployment/backend-files.json deployment/prepare_backend.py ./deployment/
RUN python deployment/prepare_backend.py /source /prepared

FROM ${PYTHON_IMAGE} AS runtime
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080 WHERETO_ENV=production VENUE_DATA_MODE=mock AI_PROVIDER=ollama AI_MODEL=qwen3:4b WHERETO_AI_WARMUP_DEV=0
WORKDIR /app
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --no-create-home --home-dir /nonexistent app
COPY --from=build /opt/venv /opt/venv
COPY --from=build --chown=app:app /prepared ./
COPY --chown=app:app deployment/backend_entry.py ./deployment/backend_entry.py
# Neither the app nor startup installs packages at runtime.
RUN /opt/venv/bin/python -m pip uninstall --yes pip \
    && rm -rf /usr/local/lib/python3.12/site-packages/pip /usr/local/lib/python3.12/site-packages/pip-*.dist-info \
    && rm -f /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12
USER app
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ['PORT']+'/health',timeout=2)"
CMD ["python","deployment/backend_entry.py"]
