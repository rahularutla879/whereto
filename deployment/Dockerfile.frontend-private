# Separately selected closed startup; normal Docker/frontend entry remains unchanged.
ARG NODE_IMAGE=node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9
FROM ${NODE_IMAGE} AS build
ARG LOCAL_FIXTURE=false
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY app ./app
COPY components ./components
COPY lib ./lib
COPY data ./data
COPY next.config.ts tsconfig.json postcss.config.mjs ./
COPY deployment/Dockerfile.frontend-private deployment/build-private-frontend.mjs deployment/frontend-private-entry.mjs deployment/frontend-private-launch.sh deployment/private-role-cohort-v1.json ./deployment/
# Only this public test transport source is considered by the test-stage compiler.
# Production compiler omits it completely; no signer or fixture credential is here.
COPY experiments/hosted_ports/frontend_fixture_identity.mjs ./experiments/hosted_ports/
RUN npm run build && if [ "$LOCAL_FIXTURE" = false ]; then node deployment/build-private-frontend.mjs; elif [ "$LOCAL_FIXTURE" = true ]; then node deployment/build-private-frontend.mjs --local-fixture; else exit 78; fi
FROM ${NODE_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8080 HOSTNAME=0.0.0.0
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/private-runtime ./private-runtime
COPY --from=build /app/node_modules/jose/dist/webapi ./node_modules/jose/dist/webapi
COPY --from=build /app/node_modules/jose/package.json /app/node_modules/jose/LICENSE.md ./node_modules/jose/
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && find /app -type f -exec chmod 0444 {} + && find /app -type d -exec chmod 0555 {} +
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["/bin/sh","/app/private-runtime/frontend-launch.sh"]
