# Build only from prepare_private_services.py's fresh, explicitly projected context.
ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
FROM ${PYTHON_IMAGE} AS dependencies
ARG ROLE
WORKDIR /build
ENV PIP_CONFIG_FILE=/dev/null PIP_DISABLE_PIP_VERSION_CHECK=1
COPY requirements.lock authority-requirements.lock ./
RUN case "$ROLE" in counter|recovery) cp authority-requirements.lock selected.lock;; backend|factory|dispatcher) cp requirements.lock selected.lock;; *) exit 78;; esac \
 && python -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --index-url https://pypi.org/simple --require-hashes --only-binary=:all: -r selected.lock \
 && /opt/venv/bin/pip check \
 && /opt/venv/bin/python -m pip uninstall --yes pip
FROM ${PYTHON_IMAGE} AS runtime
ARG ROLE
WORKDIR /app
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 WHERETO_ENV=production NODE_ENV=production PORT=8080
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --no-create-home --home-dir /nonexistent app \
 && rm -rf /usr/local/lib/python3.12/site-packages/pip /usr/local/lib/python3.12/site-packages/pip-*.dist-info \
 && rm -f /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12
COPY --from=dependencies /opt/venv /opt/venv
COPY ${ROLE}/ ./
# Root-owned source prevents an application UID from changing modes or replacing code.
RUN find /app -type f -exec chmod 0444 {} + && find /app -type d -exec chmod 0555 {} +
USER 10001:10001
EXPOSE 8080
# Liveness only; no auth token, model, Maps, session mutation or financial reserve.
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import socket,os;s=socket.create_connection(('127.0.0.1',int(os.environ['PORT'])),2);s.close()"
CMD ["python","-m","private_runtime.entry"]
