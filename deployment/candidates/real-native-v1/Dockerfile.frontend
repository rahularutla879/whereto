# Separately selected closed startup; normal Docker/frontend entry remains unchanged.
ARG NODE_IMAGE=node:24-trixie-slim@sha256:af02d57b57719b9657a45199a79264a9437940cd55b3c7b3fc99615654f124a0
FROM ${NODE_IMAGE} AS security_base
# Exact Debian13 security package, SHA checked against signed APT metadata.
RUN --mount=type=bind,source=security/zlib1g.deb,target=/tmp/zlib1g.deb,readonly \
    . /etc/os-release && test "$ID:$VERSION_ID" = "debian:13" \
    && printf '%s  %s\n' '8c27c342230503b73dfde629642c3b352e87b554e06d60cf58772f236a305ceb' /tmp/zlib1g.deb | sha256sum -c - \
    && test "$(dpkg-query -W -f='${Version}' zlib1g)" = '1:1.3.dfsg+really1.3.1-1+b1' \
    && dpkg -i /tmp/zlib1g.deb \
    && test "$(dpkg-query -W -f='${Version}' zlib1g)" = '1:1.3.dfsg+really1.3.1-1+deb13u1' \
    && dpkg --audit

FROM security_base AS build
ARG ENROLLMENT_PUBLIC_KEY=
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY app ./app
COPY components ./components
COPY lib ./lib
COPY data ./data
COPY next.config.ts tsconfig.json postcss.config.mjs ./
COPY deployment/Dockerfile.frontend-private deployment/build-private-frontend.mjs deployment/frontend-private-entry.mjs deployment/frontend-private-launch.sh deployment/private-role-cohort-v1.json deployment/real-role-cohort-v1.json ./deployment/
RUN npm run build && if [ -z "$ENROLLMENT_PUBLIC_KEY" ]; then node deployment/build-private-frontend.mjs --real-profile --unenrolled-real-candidate; else printf '%s' "$ENROLLMENT_PUBLIC_KEY" > /tmp/enrollment-public.txt; node deployment/build-private-frontend.mjs --real-profile --enrollment-public-key /tmp/enrollment-public.txt; rm /tmp/enrollment-public.txt; fi
FROM security_base AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8080 HOSTNAME=0.0.0.0
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/private-runtime ./private-runtime
COPY --from=build /app/node_modules/jose/dist/webapi ./node_modules/jose/dist/webapi
COPY --from=build /app/node_modules/jose/package.json /app/node_modules/jose/LICENSE.md ./node_modules/jose/
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && find /app -type f -exec chmod 0444 {} + && find /app -type d -exec chmod 0555 {} +
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["/bin/sh","/app/private-runtime/frontend-launch.sh"]
