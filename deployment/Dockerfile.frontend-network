# Network component artifact only; normal startup remains unchanged/refusing.
ARG NODE_IMAGE=node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9
FROM ${NODE_IMAGE} AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY app ./app
COPY components ./components
COPY lib ./lib
COPY data ./data
COPY next.config.ts tsconfig.json postcss.config.mjs ./
COPY deployment/build-identity-port.mjs deployment/private-startup-v1.json deployment/build-network-port.mjs deployment/private-network-v1.json ./deployment/
RUN npm run build && node deployment/build-network-port.mjs

FROM ${NODE_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8080 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/private-runtime ./private-runtime
COPY --from=build --chown=node:node /app/node_modules/jose/dist/webapi ./node_modules/jose/dist/webapi
COPY --from=build --chown=node:node /app/node_modules/jose/package.json /app/node_modules/jose/LICENSE.md ./node_modules/jose/
COPY --chown=node:node deployment/frontend-entry.mjs ./deployment/frontend-entry.mjs
# Package installation belongs to build stage; remove inherited runtime installers.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node","deployment/frontend-entry.mjs"]
